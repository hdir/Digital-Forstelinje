                <mxCell id="nettlege-n1" value="N1 · Effektmål&lt;br&gt;Økt tilgjengelighet og mer&lt;br&gt;likeverdig tilgang" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="1520" width="270" height="80" as="geometry"/></mxCell>
                <mxCell id="nettlege-n2" value="N2 · Effektmål&lt;br&gt;Avlastning av andre deler&lt;br&gt;av allmennlegetjenesten" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="1640" width="270" height="80" as="geometry"/></mxCell>
