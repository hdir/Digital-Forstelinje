                <mxCell id="k2" parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" value="K2 · Effektmål&lt;br&gt;Mer effektiv ressursbruk ved redusert eller utsatt&lt;br&gt;tjenestebehov og mer rettidig bruk av tjenestene" vertex="1">
                    <mxGeometry height="110" width="510" x="60" y="550" as="geometry"/>
                </mxCell>
                <mxCell id="e1" parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" value="E1 · Effektmål (hovedoppdrag)&lt;br&gt;Aktiv helserolle, forebygging,&lt;br&gt;helsekompetanse og mestring" vertex="1">
