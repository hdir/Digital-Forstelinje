                </mxCell>
                <mxCell id="p-goal" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Kildens Samfunnsmål:&lt;br&gt;God psykisk helse og livskvalitet;&lt;br&gt;god, lett tilgjengelig hjelp.&lt;br&gt;Beholdes som eget mål på detaljsiden." vertex="1">
                    <mxGeometry height="140" width="270" x="1080" y="550" as="geometry"/>
                </mxCell>
                <object label="Course of Action · Deloppdrag 5&lt;br&gt;Etablere første trinn&lt;br&gt;av en digital veiviser" tooltip="Deloppdrag 5 – Digital veiviser: Et første trinn skal etableres på tvers av de aktuelle tjenesteområdene og nettlegen, slik at innbyggerne på sikt lettere finner riktig tjeneste." id="d5">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=course;archiType=rounded;fillColor=#F5DEAA;fontColor=#333333;fontSize=16;" vertex="1">
