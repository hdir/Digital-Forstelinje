                <object label="V1 · Effektmål&lt;br&gt;Økt egenmestring&lt;br&gt;og bedre helse" tooltip="V1 – Økt egenmestring og bedre helse: Flere innbyggere opplever bedre helse gjennom forebygging, behandling og oppfølging. Foreløpig effektmål i Leveranse 2a." id="v1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
