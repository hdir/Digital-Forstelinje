    <diagram id="df-psykisk" name="D3-psykisk-helse-rus">
        <mxGraphModel dx="1386" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#333333;" value="Deloppdrag 3 – psykisk helse og rus (TB2025-18)" vertex="1">
                    <mxGeometry height="40" width="1320" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Venstre: kildens eksplisitte mål. Høyre: hovedoppdragets effektmål. + = positiv Influence (analytisk bidrag)." vertex="1">
                    <mxGeometry height="50" width="1320" x="40" y="80" as="geometry"/>
                </mxCell>
                <object label="Samfunnsmål&lt;br&gt;God psykisk helse og livskvalitet;&lt;br&gt;god og lett tilgjengelig psykisk helsehjelp" tooltip="Samfunnsmål for psykisk helse: Flere skal oppleve god psykisk helse og livskvalitet, og de som trenger psykisk helsehjelp skal få god og lett tilgjengelig hjelp. Kilde: TB2025-18." id="sg">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="500" x="60" y="150" as="geometry"/>
                </mxCell>
                </object>
                <object label="P1 · Effektmål (EM1)&lt;br&gt;Mer tilgjengelige tjenester for psykiske helseplager&lt;br&gt;gjennom økt bruk av digitale verktøy" tooltip="P1 / EM1 – Mer tilgjengelige tjenester for psykiske helseplager: Innbyggerne får mer tilgjengelige helse- og omsorgstjenester gjennom økt bruk av digitale verktøy. Kilde: TB2025-18." id="p1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="500" x="60" y="350" as="geometry"/>
                </mxCell>
                </object>
                <object label="P2 · Effektmål (EM2)&lt;br&gt;Mer effektiv ressursutnyttelse i helsetjenesten&lt;br&gt;ved økt bruk av digitale verktøy" tooltip="P2 / EM2 – Mer effektiv ressursutnyttelse: Helsetjenesten utnytter ressursene mer effektivt ved økt bruk av digitale verktøy. Kilde: TB2025-18." id="p2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="500" x="60" y="550" as="geometry"/>
                </mxCell>
                </object>
                <object label="E3 · Effektmål (hovedoppdrag)&lt;br&gt;Styrket evne til å yte helsehjelp&lt;br&gt;til flere med god kvalitet" tooltip="E3 – Helsehjelp til flere med god kvalitet: Tjenesten styrker evnen til å yte helsehjelp til flere, samtidig som kvaliteten ivaretas." id="e3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="450" x="880" y="350" as="geometry"/>
                </mxCell>
                </object>
                <mxCell id="note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="DM1–DM4 utdyper P1/P2: likere tilbud, tidligere hjelp, fleksible forløp og frigjort personelltid. Tidligere hjelp kan også støtte E1; fleksible forløp kan støtte E4. P1 er ikke det samme som E2: tilgjengelig hjelp innebærer ikke nødvendigvis enklere veivisning." vertex="1">
                    <mxGeometry height="150" width="450" x="880" y="550" as="geometry"/>
                </mxCell>
                <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Kilder: TB2025-18, målhierarki linje 408–427; TB2026-17, deloppdrag 3. P1/P2 bidrar innen psykisk helse, men realiserer ikke alene hovedoppdragets brede mål." vertex="1">
                    <mxGeometry height="60" width="1320" x="40" y="790" as="geometry"/>
                </mxCell>
                <object label="+" tooltip="Fra P1 · Effektmål (EM1) Mer tilgjengelige tjenester for psykiske helseplager gjennom økt bruk av digitale verktøy til Samfunnsmål God psykisk helse og livskvalitet; god og lett tilgjengelig psykisk helsehjelp. Bedre tilgjengelighet til tjenester for psykiske helseplager støtter samfunnsmålet om god og lett tilgjengelig psykisk helsehjelp. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="p1-sg">
                    <mxCell edge="1" parent="1" source="p1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="sg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra P2 · Effektmål (EM2) Mer effektiv ressursutnyttelse i helsetjenesten ved økt bruk av digitale verktøy til Samfunnsmål God psykisk helse og livskvalitet; god og lett tilgjengelig psykisk helsehjelp. Mer effektiv ressursutnyttelse kan gi kapasitet til bedre tilgjengelig hjelp, forutsatt at kvalitet og nødvendig helsehjelp ivaretas. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="p2-sg">
                    <mxCell edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="sg">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="30" y="605"/>
                            <mxPoint x="30" y="205"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra P1 · Effektmål (EM1) Mer tilgjengelige tjenester for psykiske helseplager gjennom økt bruk av digitale verktøy til E3 · Effektmål (hovedoppdrag) Styrket evne til å yte helsehjelp til flere med god kvalitet. Bedre tilgjengelighet til tjenester for psykiske helseplager kan bidra til at flere får hjelp innen dette helseområdet. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="p1-e3">
                    <mxCell edge="1" parent="1" source="p1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" target="e3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra P2 · Effektmål (EM2) Mer effektiv ressursutnyttelse i helsetjenesten ved økt bruk av digitale verktøy til E3 · Effektmål (hovedoppdrag) Styrket evne til å yte helsehjelp til flere med god kvalitet. Mer effektiv ressursutnyttelse kan bidra til at flere får hjelp dersom gevinsten frigjør kapasitet og kvaliteten ivaretas. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="p2-e3">
                    <mxCell edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" target="e3">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="720" y="605"/>
                            <mxPoint x="720" y="427"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                </object>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="df-verktoy" name="D2-selvhjelp-behandling">
        <mxGraphModel dx="1165" dy="925" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1150" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#333333;" value="Deloppdrag 2 – digitale selvhjelps- og behandlingsverktøy" vertex="1">
                    <mxGeometry height="40" width="1320" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="V1–V8: foreløpige effektmål i Leveranse 2a, forkortet og klassifisert som Effektmål. + = analytisk positiv Influence til hovedoppdraget." vertex="1">
                    <mxGeometry height="50" width="1320" x="40" y="80" as="geometry"/>
                </mxCell>
                <object label="V1 · Effektmål&lt;br&gt;Økt egenmestring og bedre helse" tooltip="V1 – Økt egenmestring og bedre helse: Flere innbyggere opplever bedre helse gjennom forebygging, behandling og oppfølging. Foreløpig effektmål i Leveranse 2a." id="v1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="160" as="geometry"/>
                </mxCell>
                </object>
                <object label="V2 · Effektmål&lt;br&gt;Tidlig og tilpasset støtte til forebygging" tooltip="V2 – Tidlig og tilpasset støtte: Flere får hjelp til å forebygge eller begrense helseutfordringer, på egen hånd eller med oppfølging fra helsepersonell. Foreløpig effektmål i Leveranse 2a." id="v2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="270" as="geometry"/>
                </mxCell>
                </object>
                <object label="V3 · Effektmål&lt;br&gt;Bedre tilgang til virksomme digitale behandlingsverktøy" tooltip="V3 – Bedre tilgang til digitale behandlingsverktøy: Innbyggere med behov for behandling får bedre tilgang til virksomme digitale behandlingsverktøy som del av helsehjelpen. Foreløpig effektmål i Leveranse 2a." id="v3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="380" as="geometry"/>
                </mxCell>
                </object>
                <object label="V4 · Effektmål&lt;br&gt;Mindre geografiske og organisatoriske forskjeller i tilgang" tooltip="V4 – Mer likeverdig tilgang: Geografiske og organisatoriske forskjeller i tilgang til relevante, kvalitetssikrede verktøy reduseres. Foreløpig effektmål i Leveranse 2a." id="v4">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="490" as="geometry"/>
                </mxCell>
                </object>
                <object label="V5 · Effektmål&lt;br&gt;Bedre ressursutnyttelse og økt kapasitet" tooltip="V5 – Bedre ressursutnyttelse og økt kapasitet: Helse- og omsorgstjenesten kan utnytte ressurser bedre og øke kapasiteten. Foreløpig effektmål i Leveranse 2a." id="v5">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="600" as="geometry"/>
                </mxCell>
                </object>
                <object label="V6 · Effektmål&lt;br&gt;Mer personelltid og kompetanse til de største behovene" tooltip="V6 – Personelltid til de største behovene: Helsepersonellets tid og kompetanse kan i større grad brukes til innbyggere med de største eller mest sammensatte behovene. Foreløpig effektmål i Leveranse 2a." id="v6">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="710" as="geometry"/>
                </mxCell>
                </object>
                <object label="V7 · Effektmål&lt;br&gt;Fleksibel og individuelt tilpasset behandling og oppfølging" tooltip="V7 – Fleksibel og individuelt tilpasset behandling: Behandling og oppfølging blir mer fleksibel og tilpasset den enkelte. Foreløpig effektmål i Leveranse 2a." id="v7">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="820" as="geometry"/>
                </mxCell>
                </object>
                <object label="V8 · Effektmål&lt;br&gt;Mer innovativ tjeneste i samarbeid med forskning og næringsliv" tooltip="V8 – Mer innovativ helse- og omsorgstjeneste: Tjenesten samarbeider med forskningsmiljøer og næringsliv og nyttiggjør seg deres kompetanse, kapasitet og løsninger. Foreløpig effektmål i Leveranse 2a." id="v8">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="80" width="510" x="60" y="930" as="geometry"/>
                </mxCell>
                </object>
                <object label="E1 · Effektmål (hovedoppdrag)&lt;br&gt;Aktiv helserolle, forebygging,&lt;br&gt;helsekompetanse og mestring" tooltip="E1 – Aktiv helserolle, forebygging, helsekompetanse og mestring: Innbyggerne får bedre mulighet til å ivareta egen og næres helse, forebygge helseutfordringer og mestre egen helse." id="e1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="400" x="920" y="200" as="geometry"/>
                </mxCell>
                </object>
                <object label="E3 · Effektmål (hovedoppdrag)&lt;br&gt;Helsehjelp til flere med god kvalitet" tooltip="E3 – Helsehjelp til flere med god kvalitet: Tjenesten styrker evnen til å yte helsehjelp til flere, samtidig som kvaliteten ivaretas." id="e3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="400" x="920" y="500" as="geometry"/>
                </mxCell>
                </object>
                <object label="E4 · Effektmål (hovedoppdrag)&lt;br&gt;Støtte til personellets arbeidshverdag&lt;br&gt;og sammenhengende tjenester" tooltip="E4 – Støtte til helsepersonell og sammenhengende tjenester: Digitale løsninger støtter helsepersonellets arbeidshverdag og bidrar til sammenhengende og tilgjengelige tjenester." id="e4">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="400" x="920" y="830" as="geometry"/>
                </mxCell>
                </object>
                <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Kilde: Leveranse 2a, kapittel 5.1–5.2, linje 719–736. Ingen selvstendig samfunnsmålformulering i dette kapitlet. E2 støttes særlig av resultatmål om enkel tilgang, ikke direkte av alle effektmål. V8 → E4 er et indirekte bidrag, avhengig av hva innovasjonen fører til." vertex="1">
                    <mxGeometry height="70" width="1320" x="40" y="1050" as="geometry"/>
                </mxCell>
                <object label="+" tooltip="Fra V1 · Effektmål Økt egenmestring og bedre helse til E1 · Effektmål (hovedoppdrag) Aktiv helserolle, forebygging, helsekompetanse og mestring. Bedre helse og økt egenmestring konkretiserer innbyggernes aktive rolle i å ivareta egen helse. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v1-e1">
                    <mxCell edge="1" parent="1" source="v1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" target="e1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra V2 · Effektmål Tidlig og tilpasset støtte til forebygging til E1 · Effektmål (hovedoppdrag) Aktiv helserolle, forebygging, helsekompetanse og mestring. Tidlig og tilpasset støtte kan hjelpe innbyggerne å forebygge eller begrense helseutfordringer og mestre egen helse. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v2-e1">
                    <mxCell edge="1" parent="1" source="v2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" target="e1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra V3 · Effektmål Bedre tilgang til virksomme digitale behandlingsverktøy til E3 · Effektmål (hovedoppdrag) Helsehjelp til flere med god kvalitet. Bedre tilgang til virksomme digitale behandlingsverktøy som del av helsehjelpen kan gi flere tilgang til relevant hjelp. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v3-e3">
                    <mxCell edge="1" parent="1" source="v3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" target="e3">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="780" y="420"/>
                            <mxPoint x="780" y="522"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra V4 · Effektmål Mindre geografiske og organisatoriske forskjeller i tilgang til E3 · Effektmål (hovedoppdrag) Helsehjelp til flere med god kvalitet. Mindre geografisk og organisatorisk ulikhet i tilgang kan gjøre at relevante, kvalitetssikrede verktøy når flere grupper. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v4-e3">
                    <mxCell edge="1" parent="1" source="v4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" target="e3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra V5 · Effektmål Bedre ressursutnyttelse og økt kapasitet til E3 · Effektmål (hovedoppdrag) Helsehjelp til flere med god kvalitet. Bedre ressursutnyttelse og økt kapasitet kan styrke tjenestens evne til å hjelpe flere med god kvalitet. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v5-e3">
                    <mxCell edge="1" parent="1" source="v5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" target="e3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra V6 · Effektmål Mer personelltid og kompetanse til de største behovene til E3 · Effektmål (hovedoppdrag) Helsehjelp til flere med god kvalitet. Mer tid og kompetanse til de største eller mest sammensatte behovene kan gi bedre prioritering av kapasitet og kompetanse. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v6-e3">
                    <mxCell edge="1" parent="1" source="v6" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" target="e3">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="840" y="750"/>
                            <mxPoint x="840" y="588"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra V7 · Effektmål Fleksibel og individuelt tilpasset behandling og oppfølging til E4 · Effektmål (hovedoppdrag) Støtte til personellets arbeidshverdag og sammenhengende tjenester. Fleksibel og individuelt tilpasset behandling og oppfølging kan støtte arbeidsflyt og sammenhengende tjenestetilbud. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v7-e4">
                    <mxCell edge="1" parent="1" source="v7" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" target="e4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+ (indirekte)" tooltip="Fra V8 · Effektmål Mer innovativ tjeneste i samarbeid med forskning og næringsliv til E4 · Effektmål (hovedoppdrag) Støtte til personellets arbeidshverdag og sammenhengende tjenester. Innovasjon kan indirekte støtte arbeidsflyt og sammenhengende tjenester, avhengig av hvilke løsninger og arbeidsformer samarbeidet gir. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="v8-e4">
                    <mxCell edge="1" parent="1" source="v8" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" target="e4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
            </root>
        </mxGraphModel>
