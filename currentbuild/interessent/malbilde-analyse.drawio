    <diagram id="df-nettlege" name="Kommunal-nettlege">
        <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1160" background="#ffffff">
            <root>
                <mxCell id="0"/><mxCell id="1" parent="0"/>
                <mxCell id="title" value="Kommunal nettlege – sammenheng med samfunnsmålene for digital førstelinje" style="text;html=1;align=left;fontSize=23;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
                <mxCell id="legend" value="Samfunnsmål = ønsket retning; Effektmål = forventet virkning. Stiplet pil med + = analytisk Influence. N4 er vist uten pil: tilfredshet kan indikere nytte, men oppfyller ikke samfunnsmålene i seg selv." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1800" height="70" as="geometry"/></mxCell>
                <mxCell id="g1" value="G1 · Samfunnsmål&lt;br&gt;Aktiv rolle i egen og næres helse" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="g2" value="G2 · Samfunnsmål&lt;br&gt;Hjelpe flere med god kvalitet" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="g3" value="G3 · Samfunnsmål&lt;br&gt;Sammenhengende, tilgjengelige og bærekraftige digitale løsninger&lt;br&gt;som støtter innbyggere og helsepersonell" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1" parent="1"><mxGeometry x="920" y="170" width="720" height="90" as="geometry"/></mxCell>
                <mxCell id="goals-label" value="Nettlegens overordnede mål (Samfunnsmål; tolkning av lysbilde 2–4)" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1700" height="35" as="geometry"/></mxCell>
                <mxCell id="ng1" value="NG1 · Samfunnsmål&lt;br&gt;Aktiv medvirkning&lt;br&gt;i egen og næres helse" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="ng2" value="NG2 · Samfunnsmål&lt;br&gt;Fleksibel og tilgjengelig&lt;br&gt;offentlig allmennlegetjeneste" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="ng3" value="NG3 · Samfunnsmål&lt;br&gt;Sammenhengende, tilgjengelige&lt;br&gt;og enkle offentlige tjenester" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="380" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="ng4" value="NG4 · Samfunnsmål&lt;br&gt;Bærekraftig&lt;br&gt;allmennlegetjeneste" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1340" y="380" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="outcomes-label" value="Nettlegens ønskede virkninger (Effektmål; lysbilde 6)" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1700" height="35" as="geometry"/></mxCell>
                <mxCell id="n4" value="N4 · Effektmål&lt;br&gt;Økt tilfredshet&lt;br&gt;blant innbyggere" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="n2" value="N2 · Effektmål&lt;br&gt;Avlastning av andre deler&lt;br&gt;av allmennlegetjenesten" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="n1" value="N1 · Effektmål&lt;br&gt;Økt tilgjengelighet og mer&lt;br&gt;likeverdig tilgang til allmennlege" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="620" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="n3" value="N3 · Effektmål&lt;br&gt;Mer tidsriktige&lt;br&gt;allmennlegetjenester" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1340" y="620" width="300" height="100" as="geometry"/></mxCell>
                <mxCell id="note" value="Hovedbidrag vises med pil. Ytterligere mulige bidrag: NG2 og N1 → G3/G2; NG4 og N2 → G2/G3; N3 → G1 gjennom digital dialog. N4 kan indikere brukernytte for G1/G3. Tilgang alene er ikke bevis for god kvalitet; avlastning må vurderes for tjenesten samlet." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1780" height="100" as="geometry"/></mxCell>
                <mxCell id="source" value="Kilder: Digital nettlege oppsummering, lysbilde 2–6; TB2026-17, linje 497–501. Målene er tolket, ikke formelt navngitte samfunns- og effektmål. Utprøvingen er ikke dokumentasjon på oppnådde effekter." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1780" height="70" as="geometry"/></mxCell>
                <mxCell id="ng1-g1" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ng1" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ng2-g2" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ng2" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ng3-g3" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.2083;entryY=1;" edge="1" parent="1" source="ng3" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ng4-g3" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.7917;entryY=1;" edge="1" parent="1" source="ng4" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="n2-g2" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2" target="g2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="670"/><mxPoint x="840" y="215"/></Array></mxGeometry></mxCell>
                <mxCell id="n1-g3" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0.45;entryY=1;" edge="1" parent="1" source="n1" target="g3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1244" y="670"/><mxPoint x="1244" y="290"/><mxPoint x="1244" y="260"/></Array></mxGeometry></mxCell>
                <mxCell id="n3-g3" value="+" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n3" target="g3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="670"/><mxPoint x="1680" y="215"/></Array></mxGeometry></mxCell>
