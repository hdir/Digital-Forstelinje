                </mxCell>
                </object>
                <object label="V2 · Effektmål&lt;br&gt;Tidlig og tilpasset støtte&lt;br&gt;til forebygging" tooltip="V2 – Tidlig og tilpasset støtte: Flere får hjelp til å forebygge eller begrense helseutfordringer, på egen hånd eller med oppfølging fra helsepersonell. Foreløpig effektmål i Leveranse 2a." id="v2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
