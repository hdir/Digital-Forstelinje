                <mxCell id="k1" parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" value="K1 · Effektmål&lt;br&gt;Trygge, evidensbaserte&lt;br&gt;helseråd" vertex="1">
