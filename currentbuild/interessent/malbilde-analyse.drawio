    <diagram id="df-ki" name="D1-malrettede-helserad">
        <mxGraphModel dx="1226" dy="974" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#333333;" value="Deloppdrag 1 – offentlig KI-tjeneste for målrettede helseråd" vertex="1">
                    <mxGeometry height="40" width="1320" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Venstre: satsingens eksplisitte mål (styringsdokument v1.1). Høyre: hovedoppdragets effektmål. + = analytisk positiv Influence." vertex="1">
                    <mxGeometry height="50" width="1320" x="40" y="80" as="geometry"/>
                </mxCell>
                <object label="Samfunnsmål&lt;br&gt;Lik tilgang til trygge, målrettede helseråd som&lt;br&gt;øker helsekompetansen og evnen til å ivareta helse" tooltip="Samfunnsmål for målrettede helseråd: Innbyggerne har lik tilgang til trygge helseråd som øker helsekompetansen og evnen til å forebygge og ivareta egen og andres helse." id="sg">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="510" x="60" y="150" as="geometry"/>
                </mxCell>
                </object>
                <object label="K1 · Effektmål&lt;br&gt;Trygge helseråd basert på evidensbasert kunnskap" tooltip="K1 – Trygge, evidensbaserte helseråd: Innbyggere får trygge helseråd basert på evidensbasert kunnskap. Kilde: styringsdokumentet for målrettede helseråd." id="k1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="510" x="60" y="350" as="geometry"/>
                </mxCell>
                </object>
                <object label="K2 · Effektmål&lt;br&gt;Mer effektiv ressursbruk ved redusert eller utsatt&lt;br&gt;tjenestebehov og mer rettidig bruk av tjenestene" tooltip="K2 – Mer effektiv ressursbruk: Behov for helsetjenester reduseres eller utsettes, og tjenestene brukes mer rettidig. Nødvendig helsehjelp må ikke forsinkes." id="k2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="510" x="60" y="550" as="geometry"/>
                </mxCell>
                </object>
                <object label="E1 · Effektmål (hovedoppdrag)&lt;br&gt;Aktiv helserolle, forebygging,&lt;br&gt;helsekompetanse og mestring" tooltip="E1 – Aktiv helserolle, forebygging, helsekompetanse og mestring: Innbyggerne får bedre mulighet til å ivareta egen og næres helse, forebygge helseutfordringer og mestre egen helse." id="e1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="400" x="920" y="350" as="geometry"/>
                </mxCell>
                </object>
                <object label="E3 · Effektmål (hovedoppdrag)&lt;br&gt;Helsehjelp til flere med god kvalitet" tooltip="E3 – Helsehjelp til flere med god kvalitet: Tjenesten styrker evnen til å yte helsehjelp til flere, samtidig som kvaliteten ivaretas." id="e3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="110" width="400" x="920" y="550" as="geometry"/>
                </mxCell>
                </object>
                <mxCell id="note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="K1 støtter E1 når rådene forstås og kan brukes. K2 støtter E3 dersom kapasitet faktisk frigjøres uten kvalitetstap. Rettidig tjenestebruk er ikke det samme som E2 (å finne riktig tjeneste); veivisning må ivaretas særskilt i deloppdrag 5." vertex="1">
                    <mxGeometry height="70" width="1260" x="60" y="710" as="geometry"/>
                </mxCell>
                <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Kilde: Styringsdokument offentlig KI-tjeneste for målrettede helseråd v1.1, kapittel 2.1, linje 170–181. Prosjektets resultatmål for 2026 holdes atskilt fra satsingens effekter." vertex="1">
                    <mxGeometry height="50" width="1320" x="40" y="810" as="geometry"/>
                </mxCell>
                <object label="+" tooltip="Fra K1 · Effektmål Trygge helseråd basert på evidensbasert kunnskap til Samfunnsmål Lik tilgang til trygge, målrettede helseråd som øker helsekompetansen og evnen til å ivareta helse. Trygge, evidensbaserte helseråd støtter målretningen om trygge råd, helsekompetanse og evne til å ivareta helse. Rådene må også være tilgjengelige og anvendelige. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="k1-sg">
                    <mxCell edge="1" parent="1" source="k1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="sg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+ (via anvendelse)" tooltip="Fra K1 · Effektmål Trygge helseråd basert på evidensbasert kunnskap til E1 · Effektmål (hovedoppdrag) Aktiv helserolle, forebygging, helsekompetanse og mestring. Trygge, evidensbaserte råd kan støtte helsekompetanse og mestring når innbyggerne forstår og kan anvende dem; råd alene garanterer ikke endret atferd. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="k1-e1">
                    <mxCell edge="1" parent="1" source="k1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="e1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra K2 · Effektmål Mer effektiv ressursbruk ved redusert eller utsatt tjenestebehov og mer rettidig bruk av tjenestene til E3 · Effektmål (hovedoppdrag) Helsehjelp til flere med god kvalitet. Mer effektiv ressursbruk kan styrke kapasiteten til å hjelpe flere dersom nødvendig helsehjelp ikke forsinkes og kapasitet faktisk frigjøres. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="k2-e3">
                    <mxCell edge="1" parent="1" source="k2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="e3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
            </root>
        </mxGraphModel>
