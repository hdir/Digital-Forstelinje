    <diagram id="df-nettlege" name="Kommunal-nettlege">
        <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1160" background="#ffffff">
            <root>
                <mxCell id="0"/><mxCell id="1" parent="0"/>
                <mxCell id="title" value="Kommunal nettlege – sammenheng med samfunnsmålene for digital førstelinje" style="text;html=1;align=left;fontSize=23;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
                <mxCell id="legend" value="Samfunnsmål = ønsket retning; Effektmål = forventet virkning. Stiplet pil med + = analytisk Influence. N4 er vist uten pil: tilfredshet kan indikere nytte, men oppfyller ikke samfunnsmålene i seg selv." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1800" height="70" as="geometry"/></mxCell>
                <object label="G1 · Samfunnsmål&lt;br&gt;Aktiv rolle i egen og næres helse" tooltip="G1 – Aktiv rolle i egen og næres helse: Innbyggerne kan ta en aktiv rolle i å ivareta egen og næres helse. Dette er en tolkning av målretningen i TB2026-17." id="g1">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="300" height="90" as="geometry"/></mxCell>
                </object>
                <object label="G2 · Samfunnsmål&lt;br&gt;Hjelpe flere med god kvalitet" tooltip="G2 – Hjelpe flere med god kvalitet: Helse- og omsorgstjenesten skal styrke evnen til å yte helsehjelp til flere, med god kvalitet. Dette er en tolkning av TB2026-17." id="g2">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="300" height="90" as="geometry"/></mxCell>
                </object>
                <object label="G3 · Samfunnsmål&lt;br&gt;Sammenhengende, tilgjengelige og bærekraftige digitale løsninger&lt;br&gt;som støtter innbyggere og helsepersonell" tooltip="G3 – Sammenhengende, tilgjengelige og bærekraftige digitale løsninger: Løsningene skal støtte innbyggernes behov og helsepersonellets arbeidshverdag. Dette er en tolkning av TB2026-17." id="g3">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1" parent="1"><mxGeometry x="920" y="170" width="720" height="90" as="geometry"/></mxCell>
                </object>
                <mxCell id="goals-label" value="Nettlegens overordnede mål (Samfunnsmål; tolkning av lysbilde 2–4)" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1700" height="35" as="geometry"/></mxCell>
                <object label="NG1 · Samfunnsmål&lt;br&gt;Aktiv medvirkning&lt;br&gt;i egen og næres helse" tooltip="NG1 – Aktiv medvirkning i egen og næres helse: Digital dialog og oppfølging kan styrke innbyggernes rolle. Analytisk målretning basert på nettlegepresentasjonen." id="ng1">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <object label="NG2 · Samfunnsmål&lt;br&gt;Fleksibel og tilgjengelig&lt;br&gt;offentlig allmennlegetjeneste" tooltip="NG2 – Fleksibel og tilgjengelig allmennlegetjeneste: Den offentlige allmennlegetjenesten skal være mer fleksibel og tilgjengelig. Analytisk målretning basert på nettlegepresentasjonen." id="ng2">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <object label="NG3 · Samfunnsmål&lt;br&gt;Sammenhengende, tilgjengelige&lt;br&gt;og enkle offentlige tjenester" tooltip="NG3 – Sammenhengende, tilgjengelige og enkle offentlige tjenester: Digital inngang og samarbeid med fastlege og legevakt kan støtte sammenheng. Analytisk målretning basert på nettlegepresentasjonen." id="ng3">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="380" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <object label="NG4 · Samfunnsmål&lt;br&gt;Bærekraftig&lt;br&gt;allmennlegetjeneste" tooltip="NG4 – Bærekraftig allmennlegetjeneste: Tjenesten kan bli mer bærekraftig gjennom bedre samlet ressursbruk uten at kvaliteten svekkes. Analytisk målretning basert på nettlegepresentasjonen." id="ng4">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1340" y="380" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <mxCell id="outcomes-label" value="Nettlegens ønskede virkninger (Effektmål; lysbilde 6)" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1700" height="35" as="geometry"/></mxCell>
                <object label="N4 · Effektmål&lt;br&gt;Økt tilfredshet&lt;br&gt;blant innbyggere" tooltip="N4 – Økt tilfredshet: Innbyggerne skal bli mer tilfredse. Tilfredshet alene dokumenterer ikke sammenheng, bærekraft eller god kvalitet." id="n4">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <object label="N2 · Effektmål&lt;br&gt;Avlastning av andre deler&lt;br&gt;av allmennlegetjenesten" tooltip="N2 – Avlastning: Andre deler av den offentlige allmennlegetjenesten skal avlastes. Frigjort kapasitet må vurderes for tjenesten samlet." id="n2">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <object label="N1 · Effektmål&lt;br&gt;Økt tilgjengelighet og mer&lt;br&gt;likeverdig tilgang til allmennlege" tooltip="N1 – Økt tilgjengelighet og likeverdig tilgang: Hele befolkningen skal få bedre og mer likeverdig tilgang til allmennlegetjenester. Ønsket virkning fra nettlegepresentasjonen." id="n1">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="620" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <object label="N3 · Effektmål&lt;br&gt;Mer tidsriktige&lt;br&gt;allmennlegetjenester" tooltip="N3 – Mer tidsriktige allmennlegetjenester: Den kommunale nettlegen gir et digitalt tilbud til innbyggere med problemstillinger som egner seg for videokonsultasjon." id="n3">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1340" y="620" width="300" height="100" as="geometry"/></mxCell>
                </object>
                <mxCell id="note" value="Hovedbidrag vises med pil. Ytterligere mulige bidrag: NG2 og N1 → G3/G2; NG4 og N2 → G2/G3; N3 → G1 gjennom digital dialog. N4 kan indikere brukernytte for G1/G3. Tilgang alene er ikke bevis for god kvalitet; avlastning må vurderes for tjenesten samlet." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1780" height="100" as="geometry"/></mxCell>
                <mxCell id="source" value="Kilder: Digital nettlege oppsummering, lysbilde 2–6; TB2026-17, linje 497–501. Målene er tolket, ikke formelt navngitte samfunns- og effektmål. Utprøvingen er ikke dokumentasjon på oppnådde effekter." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1780" height="70" as="geometry"/></mxCell>
                <object label="+" tooltip="Fra NG1 · Samfunnsmål Aktiv medvirkning i egen og næres helse til G1 · Samfunnsmål Aktiv rolle i egen og næres helse. Aktiv medvirkning i egen og næres helse samsvarer med G1. Digital dialog og oppfølging kan støtte slik medvirkning. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="ng1-g1">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ng1" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>
                </object>
                <object label="+" tooltip="Fra NG2 · Samfunnsmål Fleksibel og tilgjengelig offentlig allmennlegetjeneste til G2 · Samfunnsmål Hjelpe flere med god kvalitet. En mer fleksibel og tilgjengelig allmennlegetjeneste kan bidra til at flere får hjelp; god kvalitet må ivaretas og vurderes. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="ng2-g2">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ng2" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
                </object>
                <object label="+" tooltip="Fra NG3 · Samfunnsmål Sammenhengende, tilgjengelige og enkle offentlige tjenester til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger som støtter innbyggere og helsepersonell. Sammenhengende og enkle offentlige tjenester støtter G3. Sammenheng forutsetter at samarbeidet med fastlege og legevakt fungerer i praksis. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="ng3-g3">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.2083;entryY=1;" edge="1" parent="1" source="ng3" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
                </object>
                <object label="+" tooltip="Fra NG4 · Samfunnsmål Bærekraftig allmennlegetjeneste til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger som støtter innbyggere og helsepersonell. En bærekraftig allmennlegetjeneste støtter bærekraftsdelen av G3 dersom samlet kapasitet brukes bedre uten at kvaliteten svekkes. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="ng4-g3">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.7917;entryY=1;" edge="1" parent="1" source="ng4" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
                </object>
                <object label="+" tooltip="Fra N2 · Effektmål Avlastning av andre deler av allmennlegetjenesten til G2 · Samfunnsmål Hjelpe flere med god kvalitet. Avlastning kan bidra til at flere får hjelp dersom den frigjør kapasitet for tjenesten samlet og kvaliteten ivaretas. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="n2-g2">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2" target="g2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="670"/><mxPoint x="840" y="215"/></Array></mxGeometry></mxCell>
                </object>
                <object label="+" tooltip="Fra N1 · Effektmål Økt tilgjengelighet og mer likeverdig tilgang til allmennlege til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger som støtter innbyggere og helsepersonell. Økt tilgjengelighet og mer likeverdig tilgang til allmennlegetjenester støtter tilgjengelighetsdelen av G3. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="n1-g3">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=0.45;entryY=1;" edge="1" parent="1" source="n1" target="g3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1244" y="670"/><mxPoint x="1244" y="290"/><mxPoint x="1244" y="260"/></Array></mxGeometry></mxCell>
                </object>
                <object label="+" tooltip="Fra N3 · Effektmål Mer tidsriktige allmennlegetjenester til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger som støtter innbyggere og helsepersonell. Et tidsriktig digitalt tilbud kan støtte tilgjengelige og sammenhengende tjenester; faktisk samhandling og bærekraft må vurderes. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="n3-g3">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n3" target="g3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="670"/><mxPoint x="1680" y="215"/></Array></mxGeometry></mxCell>
                </object>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="df-overordnet" name="DF-overordnet">
        <mxGraphModel dx="1412" dy="1121" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#333333;" value="Digital førstelinje – overordnede mål (tolkning av TB2026-17)" vertex="1">
                    <mxGeometry height="40" width="1320" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Samfunnsmål = overordnet ønsket sluttilstand. Effektmål = forventet virkning. Stiplet pil med + = positiv Influence fra bidrag til mål, ikke dokumentert årsakssammenheng." vertex="1">
                    <mxGeometry height="50" width="1320" x="40" y="80" as="geometry"/>
                </mxCell>
                <object label="G1 · Samfunnsmål&lt;br&gt;Innbyggerne kan ta en aktiv rolle&lt;br&gt;i egen og næres helse" tooltip="G1 – Aktiv rolle i egen og næres helse: Innbyggerne kan ta en aktiv rolle i å ivareta egen og næres helse. Dette er en tolkning av målretningen i TB2026-17." id="g1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="100" width="380" x="60" y="180" as="geometry"/>
                </mxCell>
                </object>
                <object label="G2 · Samfunnsmål&lt;br&gt;Helse- og omsorgstjenesten kan hjelpe&lt;br&gt;flere med god kvalitet" tooltip="G2 – Hjelpe flere med god kvalitet: Helse- og omsorgstjenesten skal styrke evnen til å yte helsehjelp til flere, med god kvalitet. Dette er en tolkning av TB2026-17." id="g2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="100" width="380" x="500" y="180" as="geometry"/>
                </mxCell>
                </object>
                <object label="G3 · Samfunnsmål&lt;br&gt;Sammenhengende, tilgjengelige og bærekraftige&lt;br&gt;digitale løsninger for innbyggere og personell" tooltip="G3 – Sammenhengende, tilgjengelige og bærekraftige digitale løsninger: Løsningene skal støtte innbyggernes behov og helsepersonellets arbeidshverdag. Dette er en tolkning av TB2026-17." id="g3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="100" width="380" x="940" y="180" as="geometry"/>
                </mxCell>
                </object>
                <object label="E1 · Effektmål&lt;br&gt;Bedre mulighet for aktiv helserolle,&lt;br&gt;forebygging, helsekompetanse og mestring" tooltip="E1 – Aktiv helserolle, forebygging, helsekompetanse og mestring: Innbyggerne får bedre mulighet til å ivareta egen og næres helse, forebygge helseutfordringer og mestre egen helse." id="e1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="110" width="280" x="60" y="430" as="geometry"/>
                </mxCell>
                </object>
                <object label="E2 · Effektmål&lt;br&gt;Innbyggerne finner enklere riktig&lt;br&gt;helsetjeneste for sine behov" tooltip="E2 – Enklere å finne riktig helsetjeneste: En digital veiviser skal på sikt gjøre det enklere for innbyggerne å finne en tjeneste som passer deres behov." id="e2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="110" width="280" x="390" y="430" as="geometry"/>
                </mxCell>
                </object>
                <object label="E3 · Effektmål&lt;br&gt;Styrket evne til å yte helsehjelp&lt;br&gt;til flere med god kvalitet" tooltip="E3 – Helsehjelp til flere med god kvalitet: Tjenesten styrker evnen til å yte helsehjelp til flere, samtidig som kvaliteten ivaretas." id="e3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="110" width="280" x="720" y="430" as="geometry"/>
                </mxCell>
                </object>
                <object label="E4 · Effektmål&lt;br&gt;Bedre støtte til personellets arbeidshverdag&lt;br&gt;og sammenhengende, tilgjengelige tjenester" tooltip="E4 – Støtte til helsepersonell og sammenhengende tjenester: Digitale løsninger støtter helsepersonellets arbeidshverdag og bidrar til sammenhengende og tilgjengelige tjenester." id="e4">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="110" width="280" x="1050" y="430" as="geometry"/>
                </mxCell>
                </object>
                <object label="R1 · Effektmål (mellomliggende resultat)&lt;br&gt;Økt bruk av digitale selvhjelps- og behandlingsverktøy" tooltip="R1 – Økt bruk av digitale selvhjelps- og behandlingsverktøy: Et mellomliggende resultat som kan bidra til bedre helse og kapasitet når verktøyene er virksomme og brukes hensiktsmessig. Økt bruk er ikke i seg selv en dokumentert helsegevinst." id="r1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=15;" vertex="1">
                    <mxGeometry height="90" width="610" x="60" y="660" as="geometry"/>
                </mxCell>
                </object>
                <mxCell id="note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="E1–E4 er analytiske kortnavn, ikke offisielle målnumre. R1 kan bidra til E1 og E3 når verktøyene er virksomme og brukes hensiktsmessig. Flere brukere er ikke i seg selv bevis for bedre helse eller kapasitet." vertex="1">
                    <mxGeometry height="90" width="610" x="720" y="660" as="geometry"/>
                </mxCell>
                <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="Kilde: TB2026-17, oppdragsinnledning og deloppdrag 2, 4 og 5. Relasjonene er analyse. De neste sidene viser bidrag til samme E1–E4." vertex="1">
                    <mxGeometry height="50" width="1320" x="40" y="800" as="geometry"/>
                </mxCell>
                <object label="+" tooltip="Fra E1 · Effektmål Bedre mulighet for aktiv helserolle, forebygging, helsekompetanse og mestring til G1 · Samfunnsmål Innbyggerne kan ta en aktiv rolle i egen og næres helse. Kunnskap og mestring støtter innbyggernes mulighet til å ta en aktiv rolle i å ivareta egen og næres helse. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e1-g1">
                    <mxCell edge="1" parent="1" source="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="g1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra E2 · Effektmål Innbyggerne finner enklere riktig helsetjeneste for sine behov til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger for innbyggere og personell. Veivisning kan gjøre relevante tjenester mer tilgjengelige, men realiserer ikke alene sammenhengende eller bærekraftige løsninger. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e2-g3">
                    <mxCell edge="1" parent="1" source="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" target="g3">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="530" y="340"/>
                            <mxPoint x="1016" y="340"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra E3 · Effektmål Styrket evne til å yte helsehjelp til flere med god kvalitet til G2 · Samfunnsmål Helse- og omsorgstjenesten kan hjelpe flere med god kvalitet. Styrket evne til å hjelpe flere med god kvalitet uttrykker den forventede endringen som støtter den overordnede målretningen. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e3-g2">
                    <mxCell edge="1" parent="1" source="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.8;entryY=1;" target="g2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra E4 · Effektmål Bedre støtte til personellets arbeidshverdag og sammenhengende, tilgjengelige tjenester til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger for innbyggere og personell. Bedre arbeidsflyt, samhandling og tilgjengelige tjenester støtter målretningen om sammenhengende digitale løsninger. Bærekraft må også vurderes særskilt. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e4-g3">
                    <mxCell edge="1" parent="1" source="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" target="g3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra R1 · Effektmål (mellomliggende resultat) Økt bruk av digitale selvhjelps- og behandlingsverktøy til E1 · Effektmål Bedre mulighet for aktiv helserolle, forebygging, helsekompetanse og mestring. Økt bruk kan støtte egenmestring og aktiv helserolle dersom verktøyene er virksomme og brukes hensiktsmessig; bruk alene viser ikke helsegevinst. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="r1-e1">
                    <mxCell edge="1" parent="1" source="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" target="e1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra R1 · Effektmål (mellomliggende resultat) Økt bruk av digitale selvhjelps- og behandlingsverktøy til E3 · Effektmål Styrket evne til å yte helsehjelp til flere med god kvalitet. Økt bruk kan bidra til kapasitet dersom verktøyene er virksomme og brukes hensiktsmessig; bruk alene dokumenterer ikke gevinsten. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="r1-e3">
                    <mxCell edge="1" parent="1" source="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" target="e3">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
