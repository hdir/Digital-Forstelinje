                    <mxGeometry height="110" width="400" x="920" y="550" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#333333;" value="K1 støtter E1 når rådene forstås og kan brukes. K2 støtter E3 dersom kapasitet faktisk frigjøres uten kvalitetstap. Rettidig tjenestebruk er ikke det samme som E2 (å finne riktig tjeneste); veivisning må ivaretas særskilt i deloppdrag 5." vertex="1">
