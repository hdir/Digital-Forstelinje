                <mxCell id="v-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="V8 → E4 er indirekte.&lt;br&gt;Økt bruk (R1) er et mellomliggende&lt;br&gt;resultat, ikke bevis for helsegevinst.&lt;br&gt;R1 og forutsetningene er vist&lt;br&gt;på detaljsidene og forklart i teksten." vertex="1">
                    <mxGeometry height="160" width="270" x="1510" y="850" as="geometry"/>
