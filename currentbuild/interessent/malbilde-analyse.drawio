    <diagram id="df-ki" name="D1-malrettede-helserad">
        <mxGraphModel dx="1226" dy="974" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff" math="0" shadow="0">
