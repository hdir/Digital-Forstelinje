                    <mxGeometry height="100" width="160" x="40" y="330" as="geometry"/>
                </mxCell>
                <object label="E1 · Effektmål&lt;br&gt;Aktiv helserolle, forebygging,&lt;br&gt;helsekompetanse og mestring" tooltip="E1 – Aktiv helserolle, forebygging, helsekompetanse og mestring: Innbyggerne får bedre mulighet til å ivareta egen og næres helse, forebygge helseutfordringer og mestre egen helse." id="e1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
