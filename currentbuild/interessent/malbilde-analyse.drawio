                </mxCell>
                </object>
                <mxCell id="e2-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Tilgang til verktøy og rettidig bruk&lt;br&gt;er ikke det samme som veivisning.&lt;br&gt;E2 ivaretas særlig av deloppdrag 5." vertex="1">
                    <mxGeometry height="100" width="270" x="1510" y="690" as="geometry"/>
                </mxCell>
                <mxCell id="v-label" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" value="Deloppdrag 2&lt;br&gt;Selvhjelps- og&lt;br&gt;behandlingsverktøy&lt;br&gt;Leveranse 2a&lt;br&gt;(foreløpige mål)" vertex="1">
