                </mxCell>
                </object>
                <mxCell id="p-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Tidligere hjelp og fleksible forløp&lt;br&gt;er delmål som også kan støtte E1/E4.&lt;br&gt;De er ikke egne EM1/EM2." vertex="1">
