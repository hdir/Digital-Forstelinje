                </mxCell>
                <mxCell id="k-goal" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Kildens Samfunnsmål:&lt;br&gt;Lik tilgang til trygge helseråd,&lt;br&gt;økt helsekompetanse og evne&lt;br&gt;til å ivareta egen og andres helse." vertex="1">
                    <mxGeometry height="120" width="270" x="1080" y="1320" as="geometry"/>
                </mxCell>
                <mxCell id="k-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="K1 bidrar via forståelse og anvendelse.&lt;br&gt;K2 forutsetter at nødvendig hjelp&lt;br&gt;ikke forsinkes. Effektene er forventede,&lt;br&gt;ikke dokumentert oppnådd." vertex="1">
                    <mxGeometry height="120" width="270" x="1510" y="1320" as="geometry"/>
                </mxCell>
                <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Kilder: TB2026-17 (497–501); TB2025-18 (408–427); Leveranse 2a (709–736); styringsdokument målrettede helseråd v1.1 (170–181); Digital nettlege oppsummering, lysbilde 2–6. Måltekster er forkortet; pilene er analytiske bidrag. Deloppdrag 4 om forebygging/helsekompetanse er et tverrgående hensyn til E1." vertex="1">
                    <mxGeometry height="60" width="1800" x="40" y="1860" as="geometry"/>
                </mxCell>
