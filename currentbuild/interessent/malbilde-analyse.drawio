                </mxCell>
                <object label="G1 · Samfunnsmål&lt;br&gt;Aktiv rolle i egen&lt;br&gt;og næres helse" tooltip="G1 – Aktiv rolle i egen og næres helse: Innbyggerne kan ta en aktiv rolle i å ivareta egen og næres helse. Dette er en tolkning av målretningen i TB2026-17." id="g1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=17;" vertex="1">
