                <mxCell id="k2" parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" value="K2 · Effektmål&lt;br&gt;Effektiv ressursbruk: redusert/utsatt&lt;br&gt;behov og mer rettidig tjenestebruk" vertex="1">
