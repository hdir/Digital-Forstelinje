                </mxCell>
                </object>
                <object label="V3 · Effektmål&lt;br&gt;Bedre tilgang til virksomme&lt;br&gt;digitale behandlingsverktøy" tooltip="V3 – Bedre tilgang til digitale behandlingsverktøy: Innbyggere med behov for behandling får bedre tilgang til virksomme digitale behandlingsverktøy som del av helsehjelpen. Foreløpig effektmål i Leveranse 2a." id="v3">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="80" width="270" x="650" y="850" as="geometry"/>
                </mxCell>
                </object>
                <object label="V4 · Effektmål&lt;br&gt;Mindre geografiske og organisatoriske&lt;br&gt;forskjeller i tilgang" tooltip="V4 – Mer likeverdig tilgang: Geografiske og organisatoriske forskjeller i tilgang til relevante, kvalitetssikrede verktøy reduseres. Foreløpig effektmål i Leveranse 2a." id="v4">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="80" width="270" x="650" y="950" as="geometry"/>
                </mxCell>
                </object>
                <object label="V5 · Effektmål&lt;br&gt;Bedre ressursutnyttelse&lt;br&gt;og økt kapasitet" tooltip="V5 – Bedre ressursutnyttelse og økt kapasitet: Helse- og omsorgstjenesten kan utnytte ressurser bedre og øke kapasiteten. Foreløpig effektmål i Leveranse 2a." id="v5">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="80" width="270" x="650" y="1050" as="geometry"/>
                </mxCell>
                </object>
                <object label="V6 · Effektmål&lt;br&gt;Personelltid og kompetanse&lt;br&gt;til de største behovene" tooltip="V6 – Personelltid til de største behovene: Helsepersonellets tid og kompetanse kan i større grad brukes til innbyggere med de største eller mest sammensatte behovene. Foreløpig effektmål i Leveranse 2a." id="v6">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="80" width="270" x="650" y="1150" as="geometry"/>
                </mxCell>
                </object>
                <object label="V7 · Effektmål&lt;br&gt;Fleksibel og individuelt&lt;br&gt;tilpasset behandling og oppfølging" tooltip="V7 – Fleksibel og individuelt tilpasset behandling: Behandling og oppfølging blir mer fleksibel og tilpasset den enkelte. Foreløpig effektmål i Leveranse 2a." id="v7">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="80" width="270" x="1080" y="850" as="geometry"/>
                </mxCell>
                </object>
                <object label="V8 · Effektmål&lt;br&gt;Innovativ tjeneste i samarbeid&lt;br&gt;med forskning og næringsliv" tooltip="V8 – Mer innovativ helse- og omsorgstjeneste: Tjenesten samarbeider med forskningsmiljøer og næringsliv og nyttiggjør seg deres kompetanse, kapasitet og løsninger. Foreløpig effektmål i Leveranse 2a." id="v8">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="80" width="270" x="1080" y="950" as="geometry"/>
                </mxCell>
                </object>
                <mxCell id="v-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="V8 → E4 er indirekte.&lt;br&gt;Økt bruk (R1) er et mellomliggende&lt;br&gt;resultat, ikke bevis for helsegevinst.&lt;br&gt;R1 og forutsetningene er vist&lt;br&gt;på detaljsidene og forklart i teksten." vertex="1">
                    <mxGeometry height="160" width="270" x="1510" y="850" as="geometry"/>
                </mxCell>
                <mxCell id="k-label" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" value="Deloppdrag 1&lt;br&gt;Målrettede&lt;br&gt;helseråd&lt;br&gt;Styringsdokument&lt;br&gt;v1.1" vertex="1">
                    <mxGeometry height="130" width="160" x="40" y="1310" as="geometry"/>
                </mxCell>
                <object label="K1 · Effektmål&lt;br&gt;Trygge, evidensbaserte&lt;br&gt;helseråd" tooltip="K1 – Trygge, evidensbaserte helseråd: Innbyggere får trygge helseråd basert på evidensbasert kunnskap. Kilde: styringsdokumentet for målrettede helseråd." id="k1">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="90" width="270" x="220" y="1320" as="geometry"/>
                </mxCell>
                </object>
                <object label="K2 · Effektmål&lt;br&gt;Effektiv ressursbruk: redusert/utsatt&lt;br&gt;behov og mer rettidig tjenestebruk" tooltip="K2 – Mer effektiv ressursbruk: Behov for helsetjenester reduseres eller utsettes, og tjenestene brukes mer rettidig. Nødvendig helsehjelp må ikke forsinkes." id="k2">
                    <mxCell parent="1" style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1">
                    <mxGeometry height="90" width="270" x="650" y="1320" as="geometry"/>
                </mxCell>
                </object>
                <mxCell id="k-goal" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Kildens Samfunnsmål:&lt;br&gt;Lik tilgang til trygge helseråd,&lt;br&gt;økt helsekompetanse og evne&lt;br&gt;til å ivareta egen og andres helse." vertex="1">
                    <mxGeometry height="120" width="270" x="1080" y="1320" as="geometry"/>
                </mxCell>
                <mxCell id="k-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="K1 bidrar via forståelse og anvendelse.&lt;br&gt;K2 forutsetter at nødvendig hjelp&lt;br&gt;ikke forsinkes. Effektene er forventede,&lt;br&gt;ikke dokumentert oppnådd." vertex="1">
                    <mxGeometry height="120" width="270" x="1510" y="1320" as="geometry"/>
                </mxCell>
                <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" value="Kilder: TB2026-17 (497–501); TB2025-18 (408–427); Leveranse 2a (709–736); styringsdokument målrettede helseråd v1.1 (170–181); Digital nettlege oppsummering, lysbilde 2–6. Måltekster er forkortet; pilene er analytiske bidrag. Deloppdrag 4 om forebygging/helsekompetanse er et tverrgående hensyn til E1." vertex="1">
                    <mxGeometry height="60" width="1800" x="40" y="1860" as="geometry"/>
                </mxCell>
                <mxCell id="nettlege-label" value="Kommunal&lt;br&gt;nettlege&lt;br&gt;Utprøving&lt;br&gt;(2025–2027)" style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1540" width="160" height="130" as="geometry"/></mxCell>
                <object label="N1 · Effektmål&lt;br&gt;Økt tilgjengelighet og mer&lt;br&gt;likeverdig tilgang" tooltip="N1 – Økt tilgjengelighet og likeverdig tilgang: Hele befolkningen skal få bedre og mer likeverdig tilgang til allmennlegetjenester. Ønsket virkning fra nettlegepresentasjonen." id="nettlege-n1">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="1520" width="270" height="80" as="geometry"/></mxCell>
                </object>
                <object label="N2 · Effektmål&lt;br&gt;Avlastning av andre deler&lt;br&gt;av allmennlegetjenesten" tooltip="N2 – Avlastning: Andre deler av den offentlige allmennlegetjenesten skal avlastes. Frigjort kapasitet må vurderes for tjenesten samlet." id="nettlege-n2">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="1640" width="270" height="80" as="geometry"/></mxCell>
                </object>
                <object label="N3 · Effektmål&lt;br&gt;Mer tidsriktige&lt;br&gt;allmennlegetjenester" tooltip="N3 – Mer tidsriktige allmennlegetjenester: Den kommunale nettlegen gir et digitalt tilbud til innbyggere med problemstillinger som egner seg for videokonsultasjon." id="nettlege-n3">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1080" y="1520" width="270" height="80" as="geometry"/></mxCell>
                </object>
                <object label="N4 · Effektmål&lt;br&gt;Økt tilfredshet&lt;br&gt;blant innbyggere" tooltip="N4 – Økt tilfredshet: Innbyggerne skal bli mer tilfredse. Tilfredshet alene dokumenterer ikke sammenheng, bærekraft eller god kvalitet." id="nettlege-n4">
                    <mxCell style="html=1;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=outcome;archiType=oct;fillColor=#CCCCFF;fontColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1510" y="1520" width="270" height="80" as="geometry"/></mxCell>
                </object>
                <mxCell id="nettlege-note" value="N1/N2 kan støtte E3, N3 kan støtte E4. N4 er en ønsket virkning, men tilfredshet alene dokumenterer ikke måloppnåelse. Nettlegens mål og direkte bidrag til G1–G3 vises på detaljsiden Kommunal-nettlege." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="1640" width="700" height="120" as="geometry"/></mxCell>
                <object label="+" tooltip="Fra N1 · Effektmål Økt tilgjengelighet og mer likeverdig tilgang til E3 · Effektmål Styrket evne til å gi helsehjelp til flere med god kvalitet. Bedre og mer likeverdig tilgang til allmennlege kan styrke evnen til å hjelpe flere når nødvendig helsehjelp og god kvalitet ivaretas. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="nettlege-n1-e3">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="nettlege-n1" target="e3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="1560"/><mxPoint x="610" y="408"/></Array></mxGeometry></mxCell>
                </object>
                <object label="+" tooltip="Fra N2 · Effektmål Avlastning av andre deler av allmennlegetjenesten til E3 · Effektmål Styrket evne til å gi helsehjelp til flere med god kvalitet. Avlastning kan bidra til å hjelpe flere dersom den frigjør kapasitet for allmennlegetjenesten samlet og kvaliteten opprettholdes. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="nettlege-n2-e3">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="nettlege-n2" target="e3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="1680"/><mxPoint x="590" y="386"/></Array></mxGeometry></mxCell>
                </object>
                <object label="+" tooltip="Fra N3 · Effektmål Mer tidsriktige allmennlegetjenester til E4 · Effektmål Støtte til personellets arbeid og sammenhengende tjenester. Et tidsriktig digitalt tilbud kan støtte helsepersonellets arbeidsmåter og sammenhengende tjenester dersom samhandling fungerer i praksis. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="nettlege-n3-e4">
                    <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=1;exitY=0.5;entryX=1;entryY=0.1;" edge="1" parent="1" source="nettlege-n3" target="e4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="1560"/><mxPoint x="1420" y="331"/></Array></mxGeometry></mxCell>
                </object>
                <object label="+" tooltip="Fra E1 · Effektmål Aktiv helserolle, forebygging, helsekompetanse og mestring til G1 · Samfunnsmål Aktiv rolle i egen og næres helse. Kunnskap og mestring støtter innbyggernes mulighet til å ta en aktiv rolle i å ivareta egen og næres helse. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e1-g1">
                    <mxCell edge="1" parent="1" source="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="g1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra E3 · Effektmål Styrket evne til å gi helsehjelp til flere med god kvalitet til G2 · Samfunnsmål Hjelpe flere med god kvalitet. Styrket evne til å hjelpe flere med god kvalitet uttrykker den forventede endringen som støtter den overordnede målretningen. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e3-g2">
                    <mxCell edge="1" parent="1" source="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="g2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra E4 · Effektmål Støtte til personellets arbeid og sammenhengende tjenester til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger som støtter innbyggere og helsepersonell. Bedre arbeidsflyt, samhandling og tilgjengelige tjenester støtter målretningen om sammenhengende digitale løsninger. Bærekraft må også vurderes særskilt. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e4-g3">
                    <mxCell edge="1" parent="1" source="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.193;entryY=1;" target="g3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                </object>
                <object label="+" tooltip="Fra E2 · Effektmål Enklere å finne riktig helsetjeneste for behovet til G3 · Samfunnsmål Sammenhengende, tilgjengelige og bærekraftige digitale løsninger som støtter innbyggere og helsepersonell. Veivisning kan gjøre relevante tjenester mer tilgjengelige, men realiserer ikke alene sammenhengende eller bærekraftige løsninger. Koblingen er en forventet positiv påvirkning og analytisk vurdering, ikke dokumentasjon på oppnådd effekt." id="e2-g3">
                    <mxCell edge="1" parent="1" source="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;fontColor=#333333;exitX=0.5;exitY=0;entryX=0.807;entryY=1;" target="g3">
