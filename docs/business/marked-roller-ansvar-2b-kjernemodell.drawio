                <object label="↑ Gir: styringssignaler" tooltip="Strategisk eier gir; Effekt- og forbedringsansvarlig mottar: styringssignaler og prioriteringer for videre evaluering og utvikling." direction="reverse" id="e_ef_se_reverse">
                    <mxCell connectable="0" parent="e_ef_se" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=13;fontColor=#333333;labelBackgroundColor=#ffffff;labelBorderColor=#e0e4e0;spacing=4;" vertex="1">
                        <mxGeometry relative="1" x="0.0181" as="geometry">
