                </object>
                <object label="Tjenesteyter&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Kommune, helseforetak, fastlege&lt;/span&gt;" tooltip="Integrerer verktøy i tjenesteforløp, legger til rette for forsvarlig bruk og sørger for oppfølging, internkontroll og ikke-digitale alternativer. Avklarer ansvar og ansvarsovergang.&#xa;&#xa;Aktørforslag: Kommune, helseforetak, fastlege." roleId="service" roleName="Tjenesteyter" id="r_tj">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="140" y="170" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Behandler&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Helsepersonell&lt;/span&gt;" tooltip="Vurderer egnethet, anbefaler eller tildeler verktøy og følger opp. Planlegger mål, tiltak, verktøy og evaluering sammen med brukeren. I fase 1 ivaretar behandler også forløpsansvar når flere behandlere er involvert, og justerer behandlingen etter målte utfall.&#xa;&#xa;Aktørforslag: Helsepersonell." roleId="clinician" roleName="Behandler" id="r_be">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="640" y="170" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Bruker&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Innbygger, pasient, pårørende&lt;/span&gt;" tooltip="Medvirker i planleggingen, setter egne mål, bruker verktøy og kan registrere egenmålinger og erfaringer. Mottar forståelig støtte og informasjon om veien videre.&#xa;&#xa;Aktørforslag: Innbygger, pasient, pårørende." roleId="user" roleName="Bruker" id="r_br">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="1140" y="170" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Plattform og nasjonal inngang&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Norsk helsenett; innholdsansvar hos Helsedirektoratet&lt;/span&gt;" tooltip="Gir en nasjonal inngang og teknisk samhandling. Drifter felles tjenester, støtter integrasjon og leverandørtilknytning, og viser vurderte verktøy. Tilbyr en felles verktøyoversikt med visninger for bruker, behandler, tjenesteyter og innkjøper, med innhold fra Kvalitetsvurderer, Verktøyleverandør og Innkjøper. I figuren formidler plattformen utvekslinger mellom øvre og nedre lag. Dette innebærer ikke sentral lagring eller nye datarettigheter. Rollen avgjør ikke kliniske prioriteringer eller kvalitet.&#xa;&#xa;Aktørforslag: Norsk helsenett; innholdsansvar hos Helsedirektoratet." roleId="platform" roleName="Plattform og nasjonal inngang" id="r_pl">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="1240" x="140" y="420" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Innkjøper&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Helsedirektoratet, Sykehusinnkjø…&lt;/span&gt;" tooltip="Omsetter behov til anskaffelser og kontrakter med forutsigbare vilkår for pris, volum, drift, videreutvikling, kvalitetsdata og avvikling. Bruker verktøyoversikten til å se hva som finnes, hva som er vurdert og hva som allerede er anskaffet andre steder.&#xa;&#xa;Aktørforslag: Helsedirektoratet, Sykehusinnkjøp, kommuner." roleId="buyer" roleName="Innkjøper" id="r_ik">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="360" y="610" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Verktøyleverandør&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Private, ideelle, akademiske og …&lt;/span&gt;" tooltip="Utvikler, dokumenterer, sikrer, drifter og videreutvikler verktøy. Leverer dokumentasjon og utfallsdata i avtalte formater, og mottar betaling, markedsadgang, tydelige krav og en langsiktig strategisk retning.&#xa;&#xa;Aktørforslag: Private, ideelle, akademiske og offentlige miljøer." roleId="vendor" roleName="Verktøyleverandør" id="r_vl">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="950" y="610" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Kvalitetsvurderer&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Foreslått: Helsedirektoratet&lt;/span&gt;" tooltip="Vurderer verktøy mot åpne og risikoproporsjonale kriterier for effekt, pasientsikkerhet, personvern, informasjonssikkerhet, tilgjengelighet og interoperabilitet. Vurderer på nytt når utfallsdata foreligger. Dette er ikke regulatorisk godkjenning.&#xa;&#xa;Aktørforslag: Foreslått: Helsedirektoratet." roleId="quality" roleName="Kvalitetsvurderer" id="r_kv">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="360" y="930" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Effekt- og&lt;br&gt;forbedringsansvarlig&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Helsedirektoratet som eier; eval…&lt;/span&gt;" tooltip="Måler bruk, effekt, sikkerhet og ressursbruk på tvers av pasienter, med avklart dataansvar og rettslig grunnlag. Fastsetter nullpunkt og gir kunnskapen tilbake til styring, innkjøp og kvalitetsvurdering.&#xa;&#xa;Aktørforslag: Helsedirektoratet som eier; evaluering ved FHI/forskningsmiljø." roleId="outcomes" roleName="Effekt- og forbedringsansvarlig" id="r_ef">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="920" y="930" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Økosystemforvalter&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Foreslått: Helsedirektoratet&lt;/span&gt;" tooltip="Samordner initiativer, forvalter faglige rammer, krav, standarder og råd, holder oversikt, forvalter et veikart for markedet og tydeliggjør grensen mellom økosystemets fellesfunksjoner og tjenestenes ansvar.&#xa;&#xa;Aktørforslag: Foreslått: Helsedirektoratet." roleId="ecosystem" roleName="Økosystemforvalter" id="r_of">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="360" y="1240" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Strategisk eier&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Helse- og omsorgsdepartementet&lt;/span&gt;" tooltip="Setter mål og prioriteringer, avklarer ansvarsdeling og bevilger midler til innkjøp og evaluering. Gir forutsigbare oppdrag og en langsiktig strategisk retning for markedet, og bruker status, kostnader, risiko og effektkunnskap i styringen.&#xa;&#xa;Aktørforslag: Helse- og omsorgsdepartementet." roleId="owner" roleName="Strategisk eier" id="r_se">
                    <mxCell parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#ffff99;fontColor=#333333;fontFamily=Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=20;shape=mxgraph.archimate3.application;appType=role;archiType=rounded;" vertex="1">
                        <mxGeometry height="88" width="240" x="920" y="1240" as="geometry"/>
                    </mxCell>
                </object>
            </root>
